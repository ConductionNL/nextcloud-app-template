{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": ["openregister"],
	"menu": [
		{ "id": "Dashboard", "label": "Dashboard", "icon": "icon-category-dashboard", "route": "Dashboard", "order": 10 },
		{ "id": "Items", "label": "Items", "icon": "icon-files", "route": "Items", "order": 20 },
		{ "id": "Documentation", "label": "Documentation", "icon": "icon-info", "href": "https://github.com/ConductionNL/nextcloud-app-template", "section": "settings", "order": 90 },
		{ "id": "SettingsMenu", "label": "Settings", "icon": "Cog", "action": "user-settings", "order": 99 },
		{ "id": "FeaturesRoadmapMenu", "label": "Features & roadmap", "icon": "icon-toggle", "route": "FeaturesRoadmap", "section": "settings", "order": 100 }
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"widgets": [
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 1,
					"props": {
						"title": "Open items",
						"iconClass": "icon-files",
						"register": "app-template",
						"schema": "item",
						"countLabel": "items",
						"variant": "primary"
					}
				}
			]
		},
		{
			"id": "Items",
			"route": "/items",
			"type": "index",
			"title": "Items",
			"config": {
				"register": "app-template",
				"schema": "item",
				"columns": ["title", "status", "updatedAt"],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			},
			"widgets": [
				{
					"widgetKey": "object-table",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 6
				}
			]
		},
		{
			"id": "ItemDetail",
			"route": "/items/:id",
			"type": "detail",
			"title": "Item",
			"config": {
				"register": "app-template",
				"schema": "item",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "object-data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/app-template/api/settings",
				"sections": [
					{
						"title": "Version",
						"widgets": [
							{
								"type": "version-info",
								"props": {
									"appName": "App Template",
									"showUpdateButton": false,
									"isUpToDate": true,
									"title": "Version Information",
									"description": "Information about the current installation."
								}
							}
						]
					}
				]
			},
			"widgets": [
				{
					"widgetKey": "version-info",
					"slot": "section:version",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1,
					"props": {
						"appName": "App Template",
						"showUpdateButton": false,
						"isUpToDate": true,
						"title": "Version Information",
						"description": "Information about the current installation."
					}
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "custom",
			"title": "Features & roadmap",
			"component": "FeaturesRoadmap",
			"_note": "Bespoke roadmap viewer powered by the lib's CnFeaturesAndRoadmapView; integrates with the OpenRegister GitHub-issue-proxy for live issue data. Not decomposable into a typed page primitive because the roadmap surface is a specialised data-browsing experience not covered by index/detail/dashboard/settings."
		}
	]
}
