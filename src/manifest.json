{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "ViewDashboardOutline",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Examples",
			"label": "Examples",
			"icon": "ClipboardTextOutline",
			"route": "Examples",
			"order": 20
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "BookOpenVariantOutline",
			"href": "https://www.conduction.nl/academy",
			"section": "footer",
			"order": 90
		},
		{
			"id": "StoreMenu",
			"label": "Store",
			"icon": "StoreOutline",
			"route": "Store",
			"section": "footer",
			"order": 92
		},
		{
			"id": "ReportsMenu",
			"label": "Reports",
			"icon": "ChartBoxOutline",
			"route": "Reports",
			"section": "footer",
			"order": 95
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "MapMarkerPath",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		},
		{
			"id": "FlowsMenu",
			"label": "Flows",
			"icon": "Sitemap",
			"route": "Flows",
			"section": "settings",
			"order": 50
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "open-examples",
						"title": "Open examples",
						"type": "stats-block",
						"iconClass": "icon-files",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "primary"
						}
					},
					{
						"id": "in-progress",
						"title": "In progress",
						"type": "stats-block",
						"iconClass": "icon-loading",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "warning"
						}
					},
					{
						"id": "closed",
						"title": "Closed",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "success"
						}
					},
					{
						"id": "recent-examples",
						"title": "Recent examples",
						"type": "object-table",
						"content": {
							"source": {
								"register": "apptemplate",
								"schema": "example",
								"filter": { "created": { "lt": "@today" } },
								"order": { "created": "desc" },
								"limit": 5
							},
							"columns": [
								{ "key": "title", "cellClass": "cn-cell--strong" },
								{ "key": "created", "formatter": "daysSince", "cellClass": "cn-cell--muted cn-cell--end" }
							],
							"hideHeader": true,
							"borderless": true,
							"rowRoute": "ExampleDetail",
							"viewAllRoute": { "name": "Examples" },
							"emptyText": "No examples yet",
							"actions": [
								{
									"id": "close-example",
									"label": "Close example",
									"type": "object-op",
									"op": "patch",
									"values": { "status": "closed" },
									"confirm": true
								}
							]
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "open-examples", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 1 },
					{ "id": 2, "widgetId": "in-progress", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 1 },
					{ "id": 3, "widgetId": "closed", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 1 },
					{ "id": 4, "widgetId": "recent-examples", "gridX": 0, "gridY": 1, "gridWidth": 6, "gridHeight": 4 }
				]
			}
		},
		{
			"id": "Examples",
			"route": "/examples",
			"type": "index",
			"title": "Examples",
			"config": {
				"register": "apptemplate",
				"schema": "example",
				"columns": [
					"title",
					"status",
					"updatedAt"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			}
		},
		{
			"id": "ExampleDetail",
			"route": "/examples/:id",
			"type": "detail",
			"title": "Example",
			"config": {
				"register": "apptemplate",
				"schema": "example",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://nextcloud-app-template.conduction.nl"
			}
		},
		{
			"id": "Store",
			"route": "/store",
			"type": "store",
			"title": "Store",
			"config": {
				"app": "apptemplate",
				"title": "Store"
			}
		},
		{
			"id": "Reports",
			"route": "/reports",
			"type": "reports",
			"title": "Reports",
			"config": {
				"cards": [
					{
						"id": "ExamplesReport",
						"label": "Examples",
						"icon": "ClipboardTextOutline",
						"route": "ExamplesReport"
					}
				]
			}
		},
		{
			"id": "ExamplesReport",
			"route": "/reports/examples",
			"type": "dashboard",
			"title": "Examples",
			"config": {
				"widgets": [
					{
						"id": "report-examples-total",
						"title": "Examples",
						"type": "stat",
						"content": {
							"label": "Examples",
							"icon": "ClipboardTextOutline",
							"route": { "name": "Examples" },
							"format": { "style": "decimal", "decimals": 0 },
							"source": { "register": "apptemplate", "schema": "example", "metric": "count" }
						}
					},
					{
						"id": "report-examples-closed",
						"title": "Closed",
						"type": "stat",
						"content": {
							"label": "Closed",
							"icon": "CheckCircleOutline",
							"route": { "name": "Examples" },
							"format": { "style": "decimal", "decimals": 0 },
							"source": { "register": "apptemplate", "schema": "example", "metric": "count", "filter": { "status": "closed" } }
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "report-examples-total", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
					{ "id": 2, "widgetId": "report-examples-closed", "gridX": 4, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false }
				]
			}
		},
		{
			"id": "Flows",
			"route": "/flows",
			"type": "index",
			"title": "Flows",
			"config": {
				"entitySource": "flows",
				"app": "apptemplate",
				"rowRoute": "FlowDetail"
			}
		},
		{
			"id": "FlowDetail",
			"route": "/flows/:id",
			"type": "flow",
			"title": "Flow",
			"config": {
				"app": "apptemplate"
			}
		}
	],
	"discovery": {
		"public": true,
		"standards": []
	}
}
