{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "0.2.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "ViewDashboardOutline",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Examples",
			"label": "Examples",
			"icon": "ClipboardTextOutline",
			"route": "Examples",
			"order": 20
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "BookOpenVariantOutline",
			"href": "https://www.conduction.nl/academy",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "MapMarkerPath",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 100
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "open-examples",
						"title": "Open examples",
						"type": "stats-block",
						"iconClass": "icon-files",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "primary"
						}
					},
					{
						"id": "in-progress",
						"title": "In progress",
						"type": "stats-block",
						"iconClass": "icon-loading",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "warning"
						}
					},
					{
						"id": "closed",
						"title": "Closed",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"dataSource": {
							"register": "apptemplate",
							"schema": "example",
							"aggregate": "count"
						},
						"props": {
							"countLabel": "examples",
							"variant": "success"
						}
					}
				],
				"layout": [
					{ "id": 1, "widgetId": "open-examples", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 1 },
					{ "id": 2, "widgetId": "in-progress", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 1 },
					{ "id": 3, "widgetId": "closed", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 1 }
				]
			},
			"widgets": [
				{
					"id": "recent-examples",
					"widgetKey": "object-table",
					"slot": "body",
					"gridX": 0,
					"gridY": 1,
					"gridWidth": 6,
					"gridHeight": 4,
					"props": {
						"title": "Recent examples",
						"source": {
							"register": "apptemplate",
							"schema": "example",
							"filter": { "created": { "lt": "@today" } },
							"order": { "created": "desc" },
							"limit": 5
						},
						"columns": [
							{ "key": "title", "cellClass": "cn-cell--strong" },
							{ "key": "created", "formatter": "daysSince", "cellClass": "cn-cell--muted cn-cell--end" }
						],
						"hideHeader": true,
						"borderless": true,
						"rowRoute": "ExampleDetail",
						"viewAllRoute": { "name": "Examples" },
						"emptyText": "No examples yet",
						"actions": [
							{
								"id": "close-example",
								"label": "Close example",
								"type": "object-op",
								"op": "patch",
								"values": { "status": "closed" },
								"confirm": true
							}
						]
					}
				}
			]
		},
		{
			"id": "Examples",
			"route": "/examples",
			"type": "index",
			"title": "Examples",
			"config": {
				"register": "apptemplate",
				"schema": "example",
				"columns": [
					"title",
					"status",
					"updatedAt"
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				}
			},
			"widgets": [
				{
					"widgetKey": "object-table",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 6
				}
			]
		},
		{
			"id": "ExampleDetail",
			"route": "/examples/:id",
			"type": "detail",
			"title": "Example",
			"config": {
				"register": "apptemplate",
				"schema": "example",
				"sidebar": true
			},
			"widgets": [
				{
					"widgetKey": "data",
					"slot": "sidebar",
					"tabGroup": "data",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				},
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://nextcloud-app-template.conduction.nl"
			}
		}
	]
}
