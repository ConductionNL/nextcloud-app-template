# apptemplate — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either this
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt lives here (auto-generated via `phpstan --generate-baseline`).
    # Apps without debt ship an empty baseline file.
    - phpstan-baseline.neon

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.
    #
    # This template ships no vendor-bin and no lib/Resources/template, so it
    # declares no extra excludePaths. An app generated from it that grows either
    # directory adds a PLAIN path here (no `(?)` marker) — see hydra-gates
    # v1.7.3 / ConductionNL/openregister#2458 for why the conditional spellings
    # are unsafe.
    ignoreErrors: []
